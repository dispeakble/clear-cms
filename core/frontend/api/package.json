  "scripts": {
    "prebuild": "rimraf dist",
    "validate": "npm-run-all --parallel test:dev lint",
    "precommit": "yarn run test:dev",
    "prepush": "yarn run test:dev",
    "build": "nest build",
    "build:prod": "yarn run build_next_simple && nest build",
    "build_next": "yarn run lint && yarn test && next build ./src/client",
    "build_next_simple": "next build ./src/client",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:next": "next start -p 4000 ./src/client",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:prod": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test": "jest --coverage=false --updateSnapshot",
    "test:dev": "jest --updateSnapshot --coverage=true",
    "test:watch": "jest --updateSnapshot --watchAll --coverage",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
