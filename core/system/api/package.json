{
  "name": "crm-system-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "npx rimraf dist",
    "build": "nest build && cpx \"./src/utils/template/**/*\" ./dist/utils/template --clean",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "docker-build": "cd .. && docker build . -t crm-registry.me:5000/crm-system",
    "docker-push": "cd .. && docker push crm-registry.me:5000/crm-system",
    "docker-build-push": "npm run docker-build && npm run docker-push",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/common": "9.0.3",
    "@nestjs/core": "9.0.3",
    "@nestjs/microservices": "9.0.3",
    "@nestjs/platform-express": "9.0.3",
    "@nestjs/platform-fastify": "9.0.3",
    "@types/mime": "2.0.3",
    "bcrypt": "5.0.1",
    "etag": "1.8.1",
    "got": "12.1.0",
    "handlebars": "4.7.7",
    "jsonwebtoken": "8.5.1",
    "lodash": "4.17.21",
    "md5": "2.3.0",
    "mime": "3.0.0",
    "nodemailer": "6.7.7",
    "redis": "4.2.0",
    "reflect-metadata": "0.1.13",
    "rxjs": "7.5.6",
    "systeminformation": "5.12.1"
  },
  "devDependencies": {
    "@nestjs/cli": "9.0.0",
    "@nestjs/schematics": "9.0.1",
    "@nestjs/testing": "9.0.3",
    "@types/express": "4.17.13",
    "@types/jest": "28.1.6",
    "@types/md5": "2.3.2",
    "@types/multer": "1.4.7",
    "@types/node": "18.0.5",
    "@types/supertest": "2.0.12",
    "@typescript-eslint/eslint-plugin": "5.30.6",
    "@typescript-eslint/parser": "5.30.6",
    "babel-cli": "6.26.0",
    "cpx": "1.5.0",
    "eslint": "8.19.0",
    "eslint-config-prettier": "8.5.0",
    "eslint-plugin-import": "2.26.0",
    "jest": "28.1.3",
    "nestjs-redis": "1.3.3",
    "prettier": "2.7.1",
    "rimraf": "3.0.2",
    "supertest": "6.2.4",
    "ts-jest": "28.0.6",
    "ts-loader": "9.3.1",
    "ts-node": "10.9.1",
    "tsconfig-paths": "4.0.0",
    "typescript": "4.7.4"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".spec.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
