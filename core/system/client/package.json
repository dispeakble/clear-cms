  "scripts": {
    "start": "react-scripts --openssl-legacy-provider start",
    "build": "react-scripts build && rm -fr ../api/public/* && cp -Rf ./build/* ../api/public",
    "build_windows": "react-scripts build && xcopy .\\build ..\\api\\public\\ /E/H/Y",
    "test": "react-scripts test --env=jsdom",
    "compile-all": "npm run compile-css && babel src --out-dir dist",
    "compile-css": "sass src/assets/scss/clear-crm.scss dist/clear-crm.css",
    "minify-sass": "sass src/assets/scss/clear-crm.scss src/assets/css/clear-crm.min.css --output-style compressed",
    "compile-sass": "sass src/assets/scss/clear-crm.scss src/assets/css/clear-crm.css",
    "map-sass": "sass src/assets/scss/clear-crm.scss src/assets/css/clear-crm.css --source-map true"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
